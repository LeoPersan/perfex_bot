# Configurações de autenticação do Discord Bot
DISCORD_TOKEN=seu_discord_token_aqui
CLIENT_ID=seu_client_id_aqui
# GUILD_ID é opcional; se preenchido, os slash commands serão registrados instantaneamente no servidor especificado
GUILD_ID=

# Configurações do OpenRouter
OPENROUTER_API_KEY=sua_chave_openrouter_aqui
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# Estratégia de seleção de modelo gratuito: smartest (mais inteligente) ou fastest (mais rápido)
MODEL_SELECTION_STRATEGY=smartest

